#!/bin/bash
# Pre-commit hook: runs the complete local validation gate.
#
# The gate runs inside the toolbox image, so a commit needs nothing on this
# machine but Docker or Podman -- no host install of ansible-core,
# ansible-lint, yamllint, or shellcheck, and no version drift between what a
# commit was checked against here and anywhere else.
#
# Install: make install   (equivalently: git config core.hooksPath hooks)
# Skip:    git commit --no-verify
#
# The runtime container tests are deliberately not part of this gate: they pull
# the locked service images and take several minutes. Run them with
# `make test-full` when container behaviour changes.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

exec ./scripts/toolbox.sh ./scripts/test-local.sh
