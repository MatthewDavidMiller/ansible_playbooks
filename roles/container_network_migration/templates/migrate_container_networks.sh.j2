#!/bin/bash
set -Eeuo pipefail

LOG_FILE=/var/log/homelab-container-network-migration.log
exec >> "$LOG_FILE" 2>&1

echo "Starting deferred container network migration at $(date --iso-8601=seconds)"

service_names=(
{% for service_name in container_service_names.split() %}
  {{ service_name | quote }}
{% endfor %}
)

stop_services=(
  traefik_container
{% for service_name in container_service_names.split() %}
  {{ service_name | quote }}
{% endfor %}
)

restart_services() {
  local restart_failed=0

  if ! /usr/bin/systemctl daemon-reload; then
    echo "ERROR: systemd daemon-reload failed"
    restart_failed=1
  fi

  for service_name in "${service_names[@]}"; do
    unit_name="${service_name%.service}.service"
    echo "Starting ${unit_name}"
    if ! /usr/bin/systemctl start "$unit_name"; then
      echo "ERROR: Failed to start ${unit_name}"
      restart_failed=1
    fi
  done

  echo "Starting traefik_container.service"
  if ! /usr/bin/systemctl start traefik_container.service; then
    echo "ERROR: Failed to start traefik_container.service"
    restart_failed=1
  fi

  return "$restart_failed"
}

finish() {
  local status=$?
  trap - EXIT

  if ! restart_services; then
    status=1
  fi

  if (( status == 0 )); then
    echo "Completed deferred container network migration at $(date --iso-8601=seconds)"
  else
    echo "FAILED deferred container network migration at $(date --iso-8601=seconds)"
  fi
  exit "$status"
}

trap finish EXIT

for service_name in "${stop_services[@]}"; do
  unit_name="${service_name%.service}.service"
  echo "Stopping ${unit_name}"
  if ! /usr/bin/systemctl stop "$unit_name"; then
    echo "ERROR: Failed to stop ${unit_name}"
    exit 1
  fi
done

{% set migrations = container_network_migrations | default([]) | unique(attribute='name') | list %}
{% for network in migrations %}
echo "Replacing network {{ network.name }}"
if /usr/bin/podman network inspect {{ network.name | quote }} >/dev/null 2>&1; then
  if ! /usr/bin/podman network rm --force --time 30 {{ network.name | quote }}; then
    echo "ERROR: Failed to remove network {{ network.name }}"
    exit 1
  fi
fi
if ! /usr/bin/podman network inspect {{ network.name | quote }} >/dev/null 2>&1; then
{% if network.subnet | default('') | length > 0 %}
  /usr/bin/podman network create --internal --subnet {{ network.subnet | quote }} {{ network.name | quote }}
{% else %}
  /usr/bin/podman network create --internal {{ network.name | quote }}
{% endif %}
else
  echo "ERROR: Network {{ network.name }} still exists after removal"
  exit 1
fi

if ! /usr/bin/podman network inspect {{ network.name | quote }} >/dev/null 2>&1; then
  echo "ERROR: Network {{ network.name }} was not created"
  exit 1
fi
{% endfor %}
