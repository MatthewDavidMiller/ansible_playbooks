# Managed by Ansible (dev_vm role).
# Exposes user-local agent CLI paths for login shells.
if [ "$USER" = "{{ dev_vm_user }}" ]; then
{% for entry in dev_vm_path_entries %}
    if [ -d "{{ entry }}" ]; then
        case ":$PATH:" in
            *":{{ entry }}:"*) ;;
            *) PATH="{{ entry }}:$PATH" ;;
        esac
    fi
{% endfor %}
    export PATH
fi
