#!/usr/bin/env python3
"""Dynamic DNS updater: Porkbun ping → Porkbun DNS.

Reads the WAN IP from Porkbun on every run. When it differs from the last
successfully applied value, the updater reads the live A record and changes it
only when needed. The cache avoids two extra DNS API calls in steady state.

Logs to stderr; cron appends that stream to /var/log/dynamic_dns.log and
logrotate owns file rotation.
"""

import ipaddress
import logging
import os
import sys
import tempfile
from pathlib import Path

import requests

# ── Configuration (injected by Ansible at deploy time) ───────────────────────
PORKBUN_API_KEY = os.environ["PORKBUN_API_KEY"]
PORKBUN_SECRET_KEY = os.environ["PORKBUN_SECRET_KEY"]
DOMAIN = os.environ["DOMAIN"]
SUBDOMAIN = os.environ["SUBDOMAIN"]
IP_CACHE = Path("/var/cache/dynamic_dns_ip")
PORKBUN_BASE = "https://api.porkbun.com/api/json/v3"
PORKBUN_IPV4_BASE = "https://api-ipv4.porkbun.com/api/json/v3"
TIMEOUT = 10  # seconds per request

log = logging.getLogger("dynamic_dns")
log.setLevel(logging.INFO)
log.propagate = False

_formatter = logging.Formatter(
    fmt="%(asctime)s %(levelname)-8s %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
)

_stderr_handler = logging.StreamHandler(sys.stderr)
_stderr_handler.setFormatter(_formatter)
log.addHandler(_stderr_handler)


def _log_unhandled(exc_type, exc_value, exc_tb):
    log.error("Unhandled exception", exc_info=(exc_type, exc_value, exc_tb))


sys.excepthook = _log_unhandled


# ── WAN IP ────────────────────────────────────────────────────────────────────

def get_wan_ip() -> str:
    """Return the current WAN IPv4 address via the Porkbun ping endpoint.

    Uses api-ipv4.porkbun.com to guarantee an IPv4 response regardless of
    whether the host has a dual-stack connection.
    """
    result = _porkbun_post("ping", {}, base=PORKBUN_IPV4_BASE)
    ip_str = result.get("yourIp")
    if not ip_str:
        raise ValueError(f"Porkbun ping response missing 'yourIp' field: {result}")
    addr = ipaddress.ip_address(ip_str)
    if not isinstance(addr, ipaddress.IPv4Address) or not addr.is_global:
        raise ValueError(f"WAN IP {ip_str!r} is not a global IPv4 address")
    return ip_str


# ── Cache ─────────────────────────────────────────────────────────────────────

def get_cached_ip() -> str | None:
    """Return the last successfully applied IP, or None if not cached."""
    try:
        return IP_CACHE.read_text().strip() or None
    except FileNotFoundError:
        return None


def write_cached_ip(ip_address: str) -> None:
    """Atomically replace the cache with owner-only permissions."""
    IP_CACHE.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary_name = tempfile.mkstemp(prefix=f".{IP_CACHE.name}.", dir=IP_CACHE.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(ip_address)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary_name, IP_CACHE)
    except Exception:
        try:
            os.close(fd)
        except OSError:
            pass
        Path(temporary_name).unlink(missing_ok=True)
        raise


def cache_applied_ip(ip_address: str) -> bool:
    """Persist a successful reconciliation and report cache failures cleanly."""
    try:
        write_cached_ip(ip_address)
    except OSError as exc:
        log.error("Failed to write dynamic DNS cache %s: %s", IP_CACHE, exc)
        return False
    return True


# ── Porkbun ───────────────────────────────────────────────────────────────────

def _porkbun_post(endpoint: str, extra: dict, base: str = PORKBUN_BASE) -> dict:
    payload = {
        "apikey": PORKBUN_API_KEY,
        "secretapikey": PORKBUN_SECRET_KEY,
        **extra,
    }
    resp = requests.post(
        f"{base}/{endpoint}",
        json=payload,
        timeout=TIMEOUT,
    )
    try:
        result = resp.json()
    except ValueError:
        result = {}
    if not isinstance(result, dict):
        result = {}
    if not resp.ok:
        code = result.get("code", "")
        message = result.get("message", resp.reason or "")
        detail = f" ({code})" if code else ""
        raise RuntimeError(
            f"Porkbun {endpoint!r} HTTP {resp.status_code}{detail}: {message}"
        )
    if result.get("status") != "SUCCESS":
        code = result.get("code", "")
        message = result.get("message", "")
        detail = f" ({code})" if code else ""
        raise RuntimeError(
            f"Porkbun {endpoint!r} returned status "
            f"{result.get('status')!r}{detail}: {message}"
        )
    return result


def get_dns_record() -> tuple[str | None, str | None]:
    """Return (current_ip, record_id) for the subdomain A record.

    Returns (None, None) if no record exists yet.
    """
    result = _porkbun_post(
        f"dns/retrieveByNameType/{DOMAIN}/A/{SUBDOMAIN}", {}
    )
    records = result.get("records", [])
    if not isinstance(records, list) or not all(isinstance(record, dict) for record in records):
        raise RuntimeError("Porkbun DNS response contained an invalid records list")
    if not records:
        return None, None
    if len(records) > 1:
        raise RuntimeError(f"Expected one {SUBDOMAIN}.{DOMAIN} A record, found {len(records)}")

    content = records[0].get("content")
    record_id = records[0].get("id")
    if not isinstance(content, str):
        raise RuntimeError("Porkbun A record contained an invalid IPv4 address")
    try:
        parsed_content = ipaddress.ip_address(content)
    except ValueError as exc:
        raise RuntimeError("Porkbun A record contained an invalid IPv4 address") from exc
    if not isinstance(parsed_content, ipaddress.IPv4Address):
        raise RuntimeError("Porkbun A record contained an invalid IPv4 address")
    if isinstance(record_id, bool) or not isinstance(record_id, (str, int)):
        raise RuntimeError("Porkbun A record contained an invalid record ID")
    normalized_record_id = str(record_id)
    if not normalized_record_id.isdigit():
        raise RuntimeError("Porkbun A record contained an invalid record ID")
    return str(parsed_content), normalized_record_id


def update_dns_record(record_id: str | None, new_ip: str) -> None:
    """Edit the existing A record, or create one if none exists."""
    if record_id:
        _porkbun_post(
            f"dns/edit/{DOMAIN}/{record_id}",
            {
                "name": SUBDOMAIN,
                "type": "A",
                "content": new_ip,
                "ttl": 600,
            },
        )
    else:
        _porkbun_post(
            f"dns/create/{DOMAIN}",
            {
                "name": SUBDOMAIN,
                "type": "A",
                "content": new_ip,
                "ttl": 600,
            },
        )


# ── Entrypoint ────────────────────────────────────────────────────────────────

def main() -> int:
    try:
        wan_ip = get_wan_ip()
    except Exception as exc:
        log.error("Failed to get WAN IP from Porkbun ping: %s", exc)
        return 1

    try:
        cached_ip = get_cached_ip()
    except OSError as exc:
        log.error("Failed to read dynamic DNS cache %s: %s", IP_CACHE, exc)
        return 1

    # Fast path: the ping request is the only API call when the cache is current.
    if cached_ip == wan_ip:
        return 0

    try:
        current_ip, record_id = get_dns_record()
    except Exception as exc:
        log.error("Failed to retrieve DNS record from Porkbun: %s", exc)
        return 1

    if wan_ip == current_ip:
        return 0 if cache_applied_ip(wan_ip) else 1

    try:
        update_dns_record(record_id, wan_ip)
    except Exception as exc:
        log.error("Failed to update DNS record: %s", exc)
        return 1

    if not cache_applied_ip(wan_ip):
        return 1
    log.info(
        "Updated %s.%s → %s (was %s)",
        SUBDOMAIN, DOMAIN, wan_ip, current_ip or "none",
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
