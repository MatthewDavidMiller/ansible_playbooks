#!/bin/bash
# Proves the homedrive backup works, all the way to plain files:
# 1. the newest archive is extracted to scratch space;
# 2. in a one-off container with no network, every version in it is read
#    back and hashed (fsck --deep), and every user's drive is restored to
#    plain files, each verified against its SHA-256;
# 3. each restored drive's manifest is compared with the live drive: every
#    file the drive had when the backup was taken must be in it, and it
#    must hold nothing the drive never had.
# That is hours of disk and CPU, so it runs only when asked for (by hand,
# or run_backups.yml's tags), never on a schedule.
#
# --light checks a random sample instead, in minutes: only the metadata and
# the objects the sampled files need are extracted (the server names them a
# round at a time), those files are restored, each verified, and checked
# against the drive. It proves those files restore, not every file.
# --files N sets the sample's size ({{ homedrive_drill_sample }} by default).
#
# The result is reported to homedrive (kind "drill"), so a failing drill
# reaches the administrators. The restored files are deleted afterwards. To
# keep them (to copy to a client and check there with
# `homedrive check-files`), pass --keep.
set -uo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

umask 077
REPO={{ homedrive_borg_repo | quote }}
{% if homedrive_borg_passphrase | length > 0 %}
# The repository is encrypted; Borg reads its passphrase from a root-only
# file, never the command line.
export BORG_PASSCOMMAND="/usr/bin/cat {{ secret_env_dir }}/homedrive_borg_passphrase"
{% endif %}
STORE={{ homedrive_path | quote }}
SCRATCH={{ homedrive_drill_path | quote }}
LOG=/var/log/homedrive_drill.log
KEEP=false
LIGHT=false
SAMPLE={{ homedrive_drill_sample }}
while [ "$#" -gt 0 ]; do
    case "$1" in
        --keep) KEEP=true ;;
        --light) LIGHT=true ;;
        --files)
            if [ "$#" -lt 2 ] || ! [[ "$2" =~ ^[1-9][0-9]{0,3}$ ]]; then
                echo "--files takes a number, 1-9999" >&2
                exit 2
            fi
            SAMPLE="$2"
            shift
            ;;
        *) echo "Usage: $0 [--light [--files N]] [--keep]" >&2; exit 2 ;;
    esac
    shift
done

report() {
    /usr/bin/podman exec homedrive hd-server report-backup --kind drill "$@" \
        || echo "could not report to homedrive"
}

fail() {
    echo "drill failed: $1"
    report --failed --message "$1"
    exit 1
}

# Scratch space is emptied only when it is the drill's own: a directory
# holding the drill's marker, sharing no tree with the store or the
# backups (symbolic links resolved). Anything else is refused untouched.
MARKER=.homedrive-drill-scratch

within() {  # within A B: A is B or inside it
    case "$1/" in "$2"/*) return 0 ;; esac
    return 1
}

check_scratch() {
    local scratch store repo
    scratch="$(/usr/bin/realpath -m "$SCRATCH")" || return 1
    store="$(/usr/bin/realpath -m "$STORE")" || return 1
    repo="$(/usr/bin/realpath -m "$REPO")" || return 1
    for keep in "$store" "$repo"; do
        if within "$scratch" "$keep" || within "$keep" "$scratch"; then
            echo "$SCRATCH overlaps $keep"
            return 1
        fi
    done
    if [ ! -e "$SCRATCH/$MARKER" ] && [ -n "$(/usr/bin/ls -A "$SCRATCH")" ]; then
        echo "$SCRATCH holds files the drill did not put there"
        return 1
    fi
    /usr/bin/touch "$SCRATCH/$MARKER"
}

empty_scratch() {
    [ -e "$SCRATCH/$MARKER" ] || return 0
    /usr/bin/rm -rf --one-file-system "${SCRATCH:?}/store" "${SCRATCH:?}/plain" "${SCRATCH:?}/needs"
}

cleanup() {
    if [ "$KEEP" = false ]; then
        empty_scratch
    fi
}

# hd-server on the extracted copy, in a one-off container with no network.
on_copy() {
    /usr/bin/podman run --rm --pull=never --network=none \
        --user {{ homedrive_uid }}:{{ homedrive_gid }} \
        --volume "$EXTRACTED:/var/lib/homedrive:Z" \
        --volume "$SCRATCH/plain:/restore:Z" \
        --read-only --cap-drop=ALL --security-opt=no-new-privileges:true \
        {{ homedrive_image }} "$@" 2>&1
}

free_kib() {
    /usr/bin/df -Pk "$SCRATCH" | /usr/bin/awk 'NR == 2 { print $4 }'
}

# Borg keeps the absolute path, without its leading slash.
IN_ARCHIVE="${STORE#/}"

{
    echo "== $(/usr/bin/date --iso-8601=seconds) $([ "$LIGHT" = true ] && echo "light drill, $SAMPLE files" || echo "full drill")"
    [ -f "$REPO/config" ] || fail "no backup repository at $REPO"
    ARCHIVE="$(/usr/bin/borg list --lock-wait 3600 --short --glob-archives 'homedrive-*' --last 1 "$REPO")" \
        || fail "cannot list the backup repository"
    [ -n "$ARCHIVE" ] || fail "the backup repository has no archives"
    /usr/bin/mkdir -p "$SCRATCH" || fail "cannot create $SCRATCH"
    why="$(check_scratch)" || fail "refusing to use $SCRATCH as scratch space: $why"
    if [ "$LIGHT" = true ]; then
        # Room for the metadata twice over and a GiB; the sample's own room
        # is checked once its size is known.
        need_kib=$(( $(/usr/bin/du -sk "$STORE/meta" | /usr/bin/cut -f1) * 2 + 1048576 ))
    else
        # Room for the extracted store and its plain files, each at most
        # about the store's size, and a GiB to spare.
        need_kib=$(( $(/usr/bin/du -sk "$STORE" | /usr/bin/cut -f1) * 2 + 1048576 ))
    fi
    [ "$(free_kib)" -ge "$need_kib" ] \
        || fail "not enough scratch space in $SCRATCH: $(free_kib) KiB free, ${need_kib} KiB needed"
    trap cleanup EXIT
    empty_scratch
    /usr/bin/mkdir -p "$SCRATCH/store" "$SCRATCH/plain"
    EXTRACTED="$SCRATCH/store$STORE"
    if [ "$LIGHT" = true ]; then
        (cd "$SCRATCH/store" && /usr/bin/borg extract --lock-wait 3600 "$REPO::$ARCHIVE" \
            "$IN_ARCHIVE/store.id" "$IN_ARCHIVE/meta") \
            || fail "borg extract of $ARCHIVE's metadata failed"
    else
        (cd "$SCRATCH/store" && /usr/bin/borg extract --lock-wait 3600 "$REPO::$ARCHIVE") \
            || fail "borg extract of $ARCHIVE failed"
    fi
    [ -f "$EXTRACTED/store.id" ] || fail "$ARCHIVE holds no store at $STORE"
    /usr/bin/chown -R {{ homedrive_uid }}:{{ homedrive_gid }} "$SCRATCH/store" "$SCRATCH/plain"
    if [ "$LIGHT" = true ]; then
        SEED="$(/usr/bin/od -An -tx1 -N16 /dev/urandom | /usr/bin/tr -d ' \n')"
        NEEDS="$SCRATCH/needs"
        # A manifest must be there before its chunks are known, and an
        # indirect one's pieces before the file's chunks: a few rounds.
        for round in 1 2 3 4 5; do
            PLAN="$(on_copy drill-plan --sample "$SAMPLE" --seed "$SEED")" \
                || fail "$ARCHIVE: drill-plan failed: $(echo "$PLAN" | /usr/bin/tail -n 1)"
            echo "$PLAN" | /usr/bin/sed -n 's/^NEED //p' > "$NEEDS"
            [ -s "$NEEDS" ] || break
            [ "$round" -lt 5 ] || fail "$ARCHIVE: the sample still needs objects after $round rounds"
            bytes="$(echo "$PLAN" | /usr/bin/awk '/^SAMPLE_BYTES / { print $2 }')"
            need_kib=$(( ${bytes:-0} * 2 / 1024 + 1048576 ))
            [ "$(free_kib)" -ge "$need_kib" ] \
                || fail "not enough scratch space in $SCRATCH for the sample: $(free_kib) KiB free, ${need_kib} KiB needed"
            echo "round $round: extracting $(/usr/bin/wc -l < "$NEEDS") object(s)"
            /usr/bin/sed -i "s|^|$IN_ARCHIVE/|" "$NEEDS"
            (cd "$SCRATCH/store" && /usr/bin/xargs -d '\n' -a "$NEEDS" \
                /usr/bin/borg extract --lock-wait 3600 "$REPO::$ARCHIVE") \
                || fail "borg extract of the sample's objects from $ARCHIVE failed"
            /usr/bin/chown -R {{ homedrive_uid }}:{{ homedrive_gid }} "$SCRATCH/store"
        done
        OUT="$(on_copy restore-drill --to /restore --sample "$SAMPLE" --seed "$SEED")"
    else
        OUT="$(on_copy restore-drill --to /restore)"
    fi
    status=$?
    echo "$OUT"
    [ "$status" -eq 0 ] \
        || fail "$ARCHIVE: $(echo "$OUT" | /usr/bin/grep -m 3 '^PROBLEM' | /usr/bin/tr '\n' ' ')"
    TAKEN="$(echo "$OUT" | /usr/bin/awk '/^TAKEN_MS / { print $2 }')"
    COMPARE=()
    [ "$LIGHT" = true ] && COMPARE=(--sample)
    for manifest in "$SCRATCH"/plain/*.sha256; do
        [ -e "$manifest" ] || continue
        user="$(/usr/bin/basename "$manifest" .sha256)"
        /usr/bin/podman exec -i homedrive hd-server drill-compare --user "$user" --taken-ms "$TAKEN" \
            "${COMPARE[@]}" < "$manifest" || fail "$ARCHIVE: $user's restored files do not match the drive (see $LOG)"
    done
    report --ok --message "$ARCHIVE: $([ "$LIGHT" = true ] && echo "light drill: ")$(echo "$OUT" | /usr/bin/tail -n 1)"
    # (An if, not &&: as the block's last command, a false test would make
    # a drill that passed exit 1.)
    if [ "$KEEP" = true ]; then
        echo "kept the restored files in $SCRATCH/plain"
    fi
} >> "$LOG" 2>&1
