#!/bin/bash
set -euo pipefail

# The data directory holds the sealed roster and the sealed per-user data
# (playlists, stars, plays); the master key and passwords are never in it.
# Every file in it is replaced atomically, so archiving it live yields a
# consistent copy of each. The cache directory is rebuildable and skipped.

umask 077

timestamp=$(date +%m_%d_%Y)
TMP_DIR=$(mktemp -d /tmp/music-server-backup.XXXXXX)
trap 'rm -rf "$TMP_DIR"' EXIT
ARCHIVE="${TMP_DIR}/music_server_${timestamp}.tar.gz"
BACKUP_LOG=/var/log/music_server_backup.log

/usr/bin/tar -C "{{ music_server_path }}/data" --numeric-owner -czf "$ARCHIVE" .

{% if backup_local | default(false) %}
DEST="{{ nextcloud_path }}/data/{{ nextcloud_homelab_user }}/files/{{ music_server_backup_location | replace('Nextcloud:', '') }}"
/usr/bin/install -d -o {{ nextcloud_uid }} -g {{ nextcloud_gid }} -m {{ nextcloud_user_files_directory_mode | default('0770') }} "$DEST"
/usr/bin/install -o {{ nextcloud_uid }} -g {{ nextcloud_gid }} -m {{ nextcloud_user_files_file_mode | default('0660') }} "$ARCHIVE" "$DEST/"
/usr/bin/find "$DEST" -type f -name 'music_server_*.tar.gz' -mtime +30 -delete
if ! /usr/local/bin/nextcloud_scan_path.sh \
    "{{ nextcloud_homelab_user }}/files/{{ music_server_backup_location | replace('Nextcloud:', '') }}" \
    >> "$BACKUP_LOG" 2>&1; then
    echo "[$(date)] ERROR: occ files:scan failed. The archive is on disk but Nextcloud has not indexed it." \
        >> "$BACKUP_LOG"
fi
{% else %}
/usr/bin/rclone copy "$ARCHIVE" Nextcloud:{{ music_server_backup_location }}
/usr/bin/rclone delete Nextcloud:{{ music_server_backup_location }} --min-age 30d --include 'music_server_*.tar.gz'
{% endif %}
