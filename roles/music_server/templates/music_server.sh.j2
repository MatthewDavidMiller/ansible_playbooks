#!/bin/bash
set -euo pipefail

# The master key and the users file (with every password) arrive as Podman
# secrets readable only by the container user. The music is read-only and
# readable through the Nextcloud group; memory is capped without swap so the
# passwords held in memory are never paged out. The only network is the
# internal one Traefik reaches it on.
exec /usr/bin/podman run \
--pull=never \
--name music_server \
--network=music_server_container_net:ip={{ container_static_ips.music_server_proxy }},alias={{ container_dns.aliases.music_server_proxy }} \
--user {{ music_server_uid }}:{{ music_server_gid }} \
--group-add {{ music_server_music_gid }} \
--volume {{ music_server_music_path }}:/music:ro,z \
--volume {{ music_server_path }}/data:/var/lib/music-server:Z \
--volume {{ music_server_path }}/cache:/var/cache/music-server:Z \
--secret music_server_master_key,target=/run/secrets/music_server_master_key,uid={{ music_server_uid }},gid={{ music_server_gid }},mode=0400 \
--secret music_server_users,target=/run/secrets/music_server_users,uid={{ music_server_uid }},gid={{ music_server_gid }},mode=0400 \
--env MS_TRUSTED_PROXIES={{ route_proxy_traefik_ips.music_server_container_net }} \
--env MS_SCAN_INTERVAL_MINUTES={{ music_server_scan_interval_minutes }} \
--env MS_MAX_TRANSCODES={{ music_server_max_transcodes }} \
--read-only \
--tmpfs /tmp:rw,noexec,nosuid,nodev,size=64m \
--memory={{ music_server_memory }} \
--memory-swap={{ music_server_memory }} \
--pids-limit=200 \
--cap-drop=ALL \
--security-opt=no-new-privileges:true \
-d {{ music_server_image }}
