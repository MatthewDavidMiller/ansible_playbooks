#!/bin/bash
set -euo pipefail

if [ "$#" -ne 1 ] || [ -z "$1" ]; then
    echo "Usage: $0 <user/files/path>" >&2
    exit 2
fi

scan_path="/${1#/}"
lock_file="/run/lock/nextcloud-files-scan.lock"
max_attempts=12
retry_delay=5

# All local service backups use @daily and can reach files:scan at the same
# time. Serialize scans so one transient Nextcloud lock cannot strand a backup
# outside the file cache until the next full scan.
exec 9>"$lock_file"
if ! /usr/bin/flock --wait 300 9; then
    echo "Timed out waiting for the Nextcloud files:scan lock" >&2
    exit 1
fi

scan_output=$(/usr/bin/mktemp /tmp/nextcloud-files-scan.XXXXXX)
trap '/usr/bin/rm -f "$scan_output"' EXIT

scan_reported_an_error() {
    /usr/bin/grep -Eq \
        '(^Unknown user |^Error while scanning|^Home storage |^Path not found:|^Another process is already scanning|^Exception during scan:|will not be accessible due to incompatible encoding)' \
        "$scan_output"
}

for attempt in $(/usr/bin/seq 1 "$max_attempts"); do
    : > "$scan_output"

    if ! /usr/bin/podman container exists nextcloud; then
        echo "Nextcloud container does not exist" > "$scan_output"
    elif ! /usr/bin/podman exec \
        --user {{ nextcloud_uid }}:{{ nextcloud_gid }} \
        --workdir /var/www/html \
        nextcloud php /var/www/html/occ status \
        > "$scan_output" 2>&1; then
        :
    elif /usr/bin/podman exec \
        --user {{ nextcloud_uid }}:{{ nextcloud_gid }} \
        --workdir /var/www/html \
        nextcloud php /var/www/html/occ files:scan \
        --path="$scan_path" \
        > "$scan_output" 2>&1 \
        && ! scan_reported_an_error; then
        /usr/bin/cat "$scan_output"
        exit 0
    fi

    /usr/bin/cat "$scan_output" >&2
    if [ "$attempt" -lt "$max_attempts" ]; then
        echo "Nextcloud files:scan attempt $attempt/$max_attempts failed for $scan_path; retrying in ${retry_delay}s" >&2
        /usr/bin/sleep "$retry_delay"
    fi
done

echo "Nextcloud files:scan failed after $max_attempts attempts for $scan_path" >&2
exit 1
