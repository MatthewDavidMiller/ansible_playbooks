#!/bin/bash
set -euo pipefail

set -a
. "{{ secret_env_dir }}/traefik.env"
set +a

# Only the egress network's DNS server is reachable: firewalld trusts that
# network and blocks the others. Podman lists one server per network in a
# different order at each start, and Traefik uses the first three, so without
# this it can lose DNS, and with it ACME, on any start. Backends do not need
# these servers; each is in /etc/hosts through --add-host below. If the gateway
# cannot be read, Traefik still starts, so the sites stay up.
resolv_mount=()
egress_gateway="$(/usr/bin/podman network inspect \
  --format '{% raw %}{{ (index .Subnets 0).Gateway }}{% endraw %}' {{ traefik_egress_network }} || true)"
if [[ -n "${egress_gateway}" ]]; then
  printf 'nameserver %s\n' "${egress_gateway}" > {{ traefik_path }}/resolv.conf
  resolv_mount=(-v {{ traefik_path }}/resolv.conf:/etc/resolv.conf:Z,ro)
else
  echo "traefik: no gateway for {{ traefik_egress_network }}; keeping Podman's DNS servers" >&2
fi

exec /usr/bin/podman run \
  --pull=never \
  --name=traefik \
{% for net in traefik_app_networks | default(proxy_config | map(attribute='proxy_network') | list | unique, true) %}
  --network={{ net }}:{% if net in route_proxy_traefik_ips | default({}) %}ip={{ route_proxy_traefik_ips[net] }},{% endif %}alias={{ container_dns.aliases.traefik_proxy }} \
{% endfor %}
  --network={{ traefik_egress_network }}:alias={{ container_dns.aliases.traefik_egress }} \
{% for config_name in proxy_config %}
{% if route_proxy_container_ips[config_name.proxy_network] is defined %}
  --add-host={{ config_name.container_destination }}:{{ route_proxy_container_ips[config_name.proxy_network] }} \
{% endif %}
{% endfor %}
  --env PORKBUN_API_KEY \
  --env PORKBUN_SECRET_API_KEY \
  -v {{ traefik_path }}/traefik.yml:/etc/traefik/traefik.yml:Z,ro \
  -v {{ traefik_path }}/config:/etc/traefik/config:Z,ro \
  -v {{ traefik_path }}/acme.json:/acme.json:Z \
  "${resolv_mount[@]}" \
  --read-only \
  --tmpfs /tmp:rw,noexec,nosuid,nodev,size=16m \
  -p 80:80/tcp \
  -p 443:443/tcp \
  --memory=256m \
  --memory-swap=256m \
  --pids-limit=200 \
  --cap-drop=ALL \
  --cap-add=NET_BIND_SERVICE \
  --security-opt=no-new-privileges:true \
  -d {{ traefik_image }}
