#!/bin/bash
set -euo pipefail

umask 077

timestamp=$(date +%m_%d_%Y)
TMP_DIR=$(mktemp -d /tmp/semaphore-backup.XXXXXX)
trap 'rm -rf "$TMP_DIR"' EXIT
DUMP_FILE="${TMP_DIR}/semaphore_db_${timestamp}.sql"

/usr/bin/podman exec postgres pg_dump \
  -U {{ postgres_admin_user }} {{ semaphore_database_name }} \
  > "$DUMP_FILE"

{% if backup_local | default(false) %}
DEST="{{ nextcloud_path }}/data/{{ nextcloud_homelab_user }}/files/{{ semaphore_backup_location | replace('Nextcloud:', '') }}"
/usr/bin/install -d -o {{ nextcloud_uid }} -g {{ nextcloud_gid }} -m {{ nextcloud_user_files_directory_mode | default('0770') }} "$DEST"
/usr/bin/install -o {{ nextcloud_uid }} -g {{ nextcloud_gid }} -m {{ nextcloud_user_files_file_mode | default('0660') }} "$DUMP_FILE" "$DEST/"
# occ refuses to run as root; it must run as the owner of config/config.php.
if ! /usr/bin/podman exec --user {{ nextcloud_uid }}:{{ nextcloud_gid }} nextcloud php occ files:scan \
    --path="{{ nextcloud_homelab_user }}/files/{{ semaphore_backup_location | replace('Nextcloud:', '') }}" \
    >> /var/log/semaphore_backup.log 2>&1; then
    echo "[$(date)] ERROR: occ files:scan failed. The dump is on disk but Nextcloud has not indexed it." \
        >> /var/log/semaphore_backup.log
fi
{% else %}
/usr/bin/rclone copy "$DUMP_FILE" Nextcloud:{{ semaphore_backup_location }}
{% endif %}

/usr/bin/rm "$DUMP_FILE"
