#!/bin/bash
set -euo pipefail

umask 077

TMP_DIR=$(mktemp -d /tmp/vaultwarden-backup.XXXXXX)
trap 'rm -rf "$TMP_DIR"' EXIT
BACKUP_FILE="$TMP_DIR/vaultwarden_db-$(date +%m_%d_%Y).sqlite3"

/usr/bin/sqlite3 {{ vaultwarden_path }}/vw-data/db.sqlite3 ".backup '$BACKUP_FILE'"

{% if backup_destination | default('nextcloud') == 'homedrive' %}
# Stored as a new file in the drive, verified by the server. Every day's
# file is kept, as before.
DRIVE_DIR={{ (vaultwarden_backup_location | replace('Nextcloud:', '')) | quote }}
/usr/local/bin/homedrive_import_path.sh {{ homedrive_backup_user | quote }} \
    "$DRIVE_DIR/$(basename "$BACKUP_FILE")" "$BACKUP_FILE" >> /var/log/vaultwarden_backup.log 2>&1
{% elif backup_local | default(false) %}
DEST="{{ nextcloud_path }}/data/{{ nextcloud_homelab_user }}/files/{{ vaultwarden_backup_location | replace('Nextcloud:', '') }}"
/usr/bin/install -d -o {{ nextcloud_uid }} -g {{ nextcloud_gid }} -m {{ nextcloud_user_files_directory_mode | default('0770') }} "$DEST"
/usr/bin/install -o {{ nextcloud_uid }} -g {{ nextcloud_gid }} -m {{ nextcloud_user_files_file_mode | default('0660') }} "$BACKUP_FILE" "$DEST/"
if ! /usr/local/bin/nextcloud_scan_path.sh \
    "{{ nextcloud_homelab_user }}/files/{{ vaultwarden_backup_location | replace('Nextcloud:', '') }}" \
    >> /var/log/vaultwarden_backup.log 2>&1; then
    echo "[$(date)] ERROR: occ files:scan failed. The backup file is on disk but Nextcloud has not indexed it." \
        >> /var/log/vaultwarden_backup.log
fi
{% else %}
/usr/bin/rclone copy "$BACKUP_FILE" Nextcloud:{{ vaultwarden_backup_location }}
{% endif %}
