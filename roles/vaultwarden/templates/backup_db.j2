#!/bin/bash
set -euo pipefail

umask 077

TMP_DIR=$(mktemp -d /tmp/vaultwarden-backup.XXXXXX)
trap 'rm -rf "$TMP_DIR"' EXIT
BACKUP_FILE="$TMP_DIR/vaultwarden_db-$(date +%m_%d_%Y).sqlite3"

/usr/bin/sqlite3 {{ vaultwarden_path }}/vw-data/db.sqlite3 ".backup '$BACKUP_FILE'"

# Stored as a new file in the drive, verified by the server. Every day's
# file is kept, as before.
DRIVE_DIR={{ (vaultwarden_backup_location | replace('Nextcloud:', '')) | quote }}
/usr/local/bin/homedrive_import_path.sh {{ homedrive_backup_user | quote }} \
    "$DRIVE_DIR/$(basename "$BACKUP_FILE")" "$BACKUP_FILE" >> /var/log/vaultwarden_backup.log 2>&1
